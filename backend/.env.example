# For prerecorded video, set the actual recording start timestamp in ISO-8601
# with timezone, e.g. 2026-11-07T09:30:00+05:30. Leave blank if unknown.
CIVICAI_RECORDING_START_TIME=
# Optional stable ID shared by the video run and its GPS CSV import.
CIVICAI_SESSION_ID=

# Optional OpenAI-compatible chat-completions endpoint. Keep secrets in backend/.env.
CIVICAI_LLM_BASE_URL=
CIVICAI_LLM_API_KEY=
CIVICAI_LLM_MODEL=
